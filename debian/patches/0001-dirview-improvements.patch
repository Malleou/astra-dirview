+class MainWindow(QMainWindow):
+    """Главное окно приложения"""
+
+    def __init__(self):
+        super().__init__()
+
+        self.home_path = str(Path.home())
+        self.setWindowTitle(f"Dir View - {self.home_path}")
+
+        self.model = FileSystemSizeModel(self)
+        self.model.setRootPath(self.home_path)
